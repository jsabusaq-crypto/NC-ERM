# NH-ERM environment configuration (copy to .env)

# Backend
PORT=4000
# PostgreSQL connection for Prisma (internal server — §11)
DATABASE_URL="postgresql://nh_erm:change_me@localhost:5432/nh_erm?schema=public"

# Frontend dev proxy target
API_URL="http://localhost:4000"

# Auth (platform-only accounts — §12). Set a strong secret in production.
JWT_SECRET="change_me_in_production"
SESSION_TTL_MINUTES=60

# Alerts (§9) — email + in-platform. SMTP for the internal mail relay.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
ALERT_FROM="nh-erm@najran-health.local"
